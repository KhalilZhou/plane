# plane 自己的配置文件：放到 plane 安装目录下的 .env（或 ~/.plane/.env）即可。
# 不要复制到被处理的文件夹里——工作目录里的 .env 属于那个项目自己，plane 不会读它。
# 想给某个项目单独指定配置，用 PLANE_CONFIG_FILE=<路径>。
# Copy this file to .env and fill only the providers you use.

# Optional: pin the provider explicitly. When unset, plane auto-detects it from the
# credentials below (openai -> anthropic -> deepseek), falling back to deepseek.
# PLANE_PROVIDER=openai

# DeepSeek uses its Anthropic-compatible endpoint.
PLANE_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
PLANE_DEEPSEEK_API_KEY=
PLANE_DEEPSEEK_MODEL=deepseek-v4-pro

# Default OpenAI-compatible endpoint. Change this if you use another /responses-compatible service.
PLANE_OPENAI_API_BASE=https://api.openai.com/v1
PLANE_OPENAI_API_KEY=
PLANE_OPENAI_MODEL=gpt-5.6-terra

# Default Anthropic-compatible endpoint.
PLANE_ANTHROPIC_API_BASE=https://api.anthropic.com/v1
PLANE_ANTHROPIC_API_KEY=
PLANE_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional comma-separated extra env names to redact from traces and reports.
PLANE_SECRET_ENV_NAMES=
